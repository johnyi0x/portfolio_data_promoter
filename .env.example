# PnL Neon (site default). Pooled URI is fine — this process queries then sleeps.
NEON_PNL=postgresql://USER:PASSWORD@ep-pnl-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ROI Neon (bagrank ROI project). Needed for ROI and PnL+ROI posts.
NEON_BAGRANK=postgresql://USER:PASSWORD@ep-roi-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Claude (Haiku). Leave unset to run templates only — still posts.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-4-5-20251001
# CLAUDE_RATE=0
# Sentences are written from the board. Leave this at 0.
# A rate above 0 spends Claude, and a bad rewrite is thrown away.

# ---------------------------------------------------------------------------
# X / Twitter — OAuth 1.0a ONLY (the "OAuth 1.0 Keys" block on Keys & Tokens)
#
# Ignore Client ID, Client Secret, and the OAuth 2.0 Access Token.
# Those are a different login. Regenerating them does nothing here.
#
# Bearer Token (top of the page, App-Only) is the ONE exception:
#   Bearer Token → X_BEARER_TOKEN
# Posting uses OAuth 1.0a. Recent search (quote-reposts) uses this bearer.
# Without it, search returns 401 and the account only posts charts.
#
# Consumer Key regenerate → TWO values:
#   Consumer Key     → X_API_KEY
#   Consumer Secret  → X_API_SECRET
#
# OAuth 1.0 Access Token regenerate (the row under "OAuth 1.0 Keys",
# NOT the one under "OAuth 2.0 Keys") → TWO values:
#   Access Token        → X_ACCESS_TOKEN
#   Access Token Secret → X_ACCESS_TOKEN_SECRET
# The OAuth 1.0 token must say Read and write, For @yourhandle.
# ---------------------------------------------------------------------------
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Bearer Token on Keys & Tokens (App-Only). Used ONLY for recent search / quote-reposts.
X_BEARER_TOKEN=
# X_USER=johnyi0x

# SITE_URL=https://bagrank.xyz
# DATA_DIR=data
# DRY_RUN=0
# MIN_INTERVAL_MIN=110
# MAX_INTERVAL_MIN=190
# MAX_POSTS_PER_DAY=8
# PROMO_BEFORE_QUOTE=2
# SKIP_RATE=0.08
# QUOTES=0
# Leave this off. Recent search is billed per tweet and per user account returned.
# That is the read spike. A normal post does not search.
# VENUE=hyperliquid
